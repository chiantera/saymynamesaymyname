# Local fictional-data demo only. No paid APIs or cloud services are used.
APP_ENV=development
ALLOW_LOCAL_DEMO=1
# Optional absolute path; default is .local/demo.sqlite under the repo root.
# DEMO_DATABASE_PATH=
# Never place server credentials in a VITE_* variable.

# Optional frontend configuration (publishable, never service-role credentials).
# Put these into frontend/.env.local for local authenticated testing:
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# VITE_BROWSER_PREVIEW=1 enables isolated fictional browser storage on hosted previews.
