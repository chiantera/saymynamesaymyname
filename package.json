{
  "name": "relationship-companion-workspace",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm --prefix frontend run build",
    "test": "node scripts/check-locales.mjs && npm --prefix frontend test",
    "test:backend": "uv run --directory backend pytest",
    "check": "npm run test:docs && npm test && npm run test:backend && npm run build",
    "test:browser": "uv run --directory backend python scripts/browser_smoke.py",
    "test:auth": "uv run --directory backend python scripts/auth_smoke.py",
    "test:database": "uv run --directory backend pytest dbtests --ignore-glob=dbtests/*_browser.py -q",
    "test:membership": "uv run --directory backend pytest dbtests/test_membership_browser.py -q --tb=short",
    "test:docs": "node scripts/check-docs.mjs",
    "worker:check": "uv run --directory backend python -m app.local_worker --check",
    "worker:local": "uv run --directory backend python -m app.local_worker"
  },
  "engines": {
    "node": "24.x"
  }
}
